{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydra.dev/schemas/product_intelligence.schema.json",
  "title": "Product Intelligence",
  "description": "The official Product Intelligence contract for HYDRA. This schema is the single source of truth for product fields. Every engine consumes it; no engine may redefine these fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product",
    "features",
    "benefits",
    "usp",
    "target_customer",
    "pain_points",
    "objections",
    "visual_analysis",
    "scores"
  ],
  "$defs": {
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  },
  "properties": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "brand", "category", "marketplace", "price", "currency"],
      "properties": {
        "name": { "type": "string", "description": "Product name." },
        "brand": { "type": "string", "description": "Brand or seller." },
        "category": { "type": "string", "description": "Product category / niche." },
        "marketplace": { "type": "string", "description": "Where the product is sold." },
        "product_url": { "type": "string", "format": "uri", "description": "Link to the product listing." },
        "price": { "type": "number", "minimum": 0, "description": "Numeric price of the product." },
        "currency": { "type": "string", "description": "ISO 4217 currency code, e.g. USD." }
      }
    },
    "features": {
      "type": "array",
      "description": "Concrete product features.",
      "items": { "type": "string" }
    },
    "benefits": {
      "type": "array",
      "description": "Customer-facing benefits derived from the features.",
      "items": { "type": "string" }
    },
    "usp": {
      "type": "string",
      "description": "Unique Selling Proposition — the one thing that sets the product apart."
    },
    "target_customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persona"],
      "properties": {
        "age_range": { "type": "string", "description": "Target age range, e.g. 25-34." },
        "gender": { "type": "string", "description": "Target gender, or a neutral value where not applicable." },
        "persona": { "type": "string", "description": "Short description of the target customer persona." }
      }
    },
    "pain_points": {
      "type": "array",
      "description": "Customer problems the product addresses.",
      "items": { "type": "string" }
    },
    "objections": {
      "type": "array",
      "description": "Reasons a customer might hesitate to buy.",
      "items": { "type": "string" }
    },
    "visual_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["demo_possible", "before_after", "transformation"],
      "properties": {
        "demo_possible": { "type": "boolean", "description": "Can the benefit be demonstrated on screen?" },
        "before_after": { "type": "boolean", "description": "Is a before/after comparison possible?" },
        "transformation": { "type": "boolean", "description": "Is a transformation possible?" }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual_strength", "problem_strength", "emotion_strength"],
      "properties": {
        "visual_strength": { "$ref": "#/$defs/score", "description": "Strength of the visual proof (0-100)." },
        "problem_strength": { "$ref": "#/$defs/score", "description": "Severity of the problem solved (0-100)." },
        "emotion_strength": { "$ref": "#/$defs/score", "description": "Strength of the emotional appeal (0-100)." }
      }
    }
  }
}
