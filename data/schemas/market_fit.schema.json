{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydra.dev/schemas/market_fit.schema.json",
  "title": "Market Fit Result",
  "description": "Output contract for the HYDRA Market Fit Engine. Evaluates whether a product deserves creative production before any advertisement is generated. This engine never produces creative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "market_fit_score",
    "decision",
    "strengths",
    "weaknesses",
    "recommended_strategy",
    "recommended_hook_type",
    "confidence"
  ],
  "$defs": {
    "category_name": {
      "type": "string",
      "enum": [
        "Visual Demonstration",
        "Problem Severity",
        "Emotional Appeal",
        "Impulse Buying",
        "Price Advantage",
        "Novelty",
        "Competition",
        "Trust",
        "Creative Diversity",
        "Viral Potential"
      ]
    },
    "scored_category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "score", "reason"],
      "properties": {
        "category": { "$ref": "#/$defs/category_name" },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "Points awarded for this category, up to its maximum."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Written justification for the score. Required — no hidden reasoning."
        }
      }
    }
  },
  "properties": {
    "market_fit_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Weighted total of the scoring categories."
    },
    "decision": {
      "type": "string",
      "enum": [
        "Create Immediately",
        "Priority A",
        "Priority B",
        "Optional",
        "Reject"
      ]
    },
    "strengths": {
      "type": "array",
      "description": "Strongest scoring categories, each with a written reason.",
      "items": { "$ref": "#/$defs/scored_category" }
    },
    "weaknesses": {
      "type": "array",
      "description": "Weakest scoring categories, each with a written reason.",
      "items": { "$ref": "#/$defs/scored_category" }
    },
    "recommended_strategy": {
      "type": "string",
      "description": "Marketing strategy the evidence points to."
    },
    "recommended_hook_type": {
      "type": "string",
      "description": "Hook type the evidence points to."
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "How confident the evaluation is."
    }
  }
}
